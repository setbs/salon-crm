generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  EMPLOYEE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  BLIK
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum ConsumableUnit {
  ML
  GRAM
}

model User {
  id           BigInt   @id @default(autoincrement())
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  phone        String   @db.VarChar(20)
  email        String?  @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  role         UserRole @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employeeProfile    Employee?
  clientAppointments Appointment[]     @relation("ClientAppointments")
  productSales       ProductSale[]     @relation("ClientProductSales")
  notificationLogs   NotificationLog[]
  reportExportLogs   ReportExportLog[] @relation("AdminReportExports")
  appointmentAuditLogs AppointmentAuditLog[] @relation("AppointmentAuditActor")

  @@map("users")
}

model Employee {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @unique @map("user_id")
  specialization String?  @db.VarChar(255)
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     EmployeeService[]
  appointments Appointment[]
  workingHours WorkingHour[]
  portfolio    PortfolioPhoto[]
  timeOff      EmployeeTimeOff[]
  productSales ProductSale[]     @relation("ProductSaleEmployee")

  @@map("employees")
}

model Service {
  id              BigInt   @id @default(autoincrement())
  categoryId      BigInt?  @map("category_id")
  name            String   @db.VarChar(255)
  description     String?
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  priceFrom       Decimal? @map("price_from") @db.Decimal(10, 2)
  priceTo         Decimal? @map("price_to") @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  category        ServiceCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employees       EmployeeService[]
  appointments    AppointmentService[]
  consumables     ServiceConsumable[]
  consumptionLogs ServiceConsumptionLog[]

  @@map("services")
}

model ServiceCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  services Service[]

  @@map("service_categories")
}

model EmployeeService {
  employeeId BigInt @map("employee_id")
  serviceId  BigInt @map("service_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@map("employee_services")
}

model Appointment {
  id              BigInt            @id @default(autoincrement())
  clientId        BigInt            @map("client_id")
  employeeId      BigInt            @map("employee_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime          @map("end_time")
  status          AppointmentStatus @default(PENDING)
  clientComment   String?           @map("client_comment")
  employeeComment String?           @map("employee_comment")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  client                 User                    @relation("ClientAppointments", fields: [clientId], references: [id])
  employee               Employee                @relation(fields: [employeeId], references: [id])
  services               AppointmentService[]
  payment                Payment?
  review                 Review?
  notificationLogs       NotificationLog[]
  serviceConsumptionLogs ServiceConsumptionLog[]
  auditLogs              AppointmentAuditLog[]

  @@index([employeeId, startTime, endTime])
  @@map("appointments")
}

model AppointmentService {
  appointmentId BigInt @map("appointment_id")
  serviceId     BigInt @map("service_id")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

model WorkingHour {
  id         BigInt @id @default(autoincrement())
  employeeId BigInt @map("employee_id")
  dayOfWeek  Int    @map("day_of_week")
  startTime  String @map("start_time") @db.VarChar(5)
  endTime    String @map("end_time") @db.VarChar(5)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@map("working_hours")
}

model EmployeeTimeOff {
  id         BigInt   @id @default(autoincrement())
  employeeId BigInt   @map("employee_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_time_off")
}

model Payment {
  id            BigInt        @id @default(autoincrement())
  appointmentId BigInt?       @unique @map("appointment_id")
  productSaleId BigInt?       @unique @map("product_sale_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productSale ProductSale? @relation(fields: [productSaleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model PortfolioPhoto {
  id          BigInt   @id @default(autoincrement())
  employeeId  BigInt   @map("employee_id")
  imageUrl    String   @map("image_url") @db.VarChar(1000)
  description String?
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("portfolio_photos")
}

model Review {
  id            BigInt   @id @default(autoincrement())
  appointmentId BigInt   @unique @map("appointment_id")
  rating        Int
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model SalonSetting {
  id          BigInt   @id @default(autoincrement())
  salonName   String   @map("salon_name") @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  address     String?  @db.VarChar(500)
  openingTime String?  @map("opening_time") @db.VarChar(5)
  closingTime String?  @map("closing_time") @db.VarChar(5)
  logoUrl     String?  @map("logo_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("salon_settings")
}

model BusinessHour {
  id        BigInt   @id @default(autoincrement())
  dayOfWeek Int      @map("day_of_week")
  openTime  String?  @map("open_time") @db.VarChar(5)
  closeTime String?  @map("close_time") @db.VarChar(5)
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model ProductCategory {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?
  imageUrl    String?  @map("image_url") @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("product_categories")
}

model ProductBrand {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("product_brands")
}

model Product {
  id                 BigInt          @id @default(autoincrement())
  categoryId         BigInt?         @map("category_id")
  brandId            BigInt?         @map("brand_id")
  name               String          @db.VarChar(255)
  brand              String?         @db.VarChar(255)
  description        String?
  quote              String?
  sku                String?         @unique @db.VarChar(100)
  imageUrl           String?         @map("image_url") @db.VarChar(1000)
  productPurpose     String          @default("BOTH") @map("product_purpose") @db.VarChar(20)
  purchasePrice      Decimal?        @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice       Decimal         @map("selling_price") @db.Decimal(10, 2)
  stockQuantity      Int             @map("stock_quantity")
  minStockQuantity   Int             @map("min_stock_quantity")
  contentAmount      Decimal?        @map("content_amount") @db.Decimal(10, 2)
  contentUnit        ConsumableUnit? @map("content_unit")
  stockContentAmount Decimal?        @map("stock_content_amount") @db.Decimal(10, 2)
  isActive           Boolean         @default(true) @map("is_active")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  category               ProductCategory?        @relation(fields: [categoryId], references: [id])
  brandRef               ProductBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  saleItems              ProductSaleItem[]
  stockMovements         StockMovement[]
  serviceConsumables     ServiceConsumable[]
  serviceConsumptionLogs ServiceConsumptionLog[]

  @@map("products")
}

model ServiceConsumable {
  id        BigInt         @id @default(autoincrement())
  serviceId BigInt         @map("service_id")
  productId BigInt         @map("product_id")
  quantity  Decimal        @db.Decimal(10, 2)
  unit      ConsumableUnit
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([serviceId, productId])
  @@map("service_consumables")
}

model ServiceConsumptionLog {
  id                 BigInt         @id @default(autoincrement())
  appointmentId      BigInt         @map("appointment_id")
  serviceId          BigInt         @map("service_id")
  productId          BigInt         @map("product_id")
  quantity           Decimal        @db.Decimal(10, 2)
  unit               ConsumableUnit
  stockContentBefore Decimal?       @map("stock_content_before") @db.Decimal(10, 2)
  stockContentAfter  Decimal?       @map("stock_content_after") @db.Decimal(10, 2)
  createdAt          DateTime       @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([appointmentId])
  @@index([productId])
  @@map("service_consumption_logs")
}

model AppointmentAuditLog {
  id            BigInt   @id @default(autoincrement())
  appointmentId BigInt   @map("appointment_id")
  actorUserId   BigInt?  @map("actor_user_id")
  eventType     String   @map("event_type") @db.VarChar(80)
  summary       String   @db.VarChar(500)
  details       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation("AppointmentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("appointment_audit_logs")
}

model ProductSale {
  id          BigInt   @id @default(autoincrement())
  clientId    BigInt?  @map("client_id")
  employeeId  BigInt?  @map("employee_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  saleDate    DateTime @map("sale_date")
  createdAt   DateTime @default(now()) @map("created_at")

  client   User?             @relation("ClientProductSales", fields: [clientId], references: [id])
  employee Employee?         @relation("ProductSaleEmployee", fields: [employeeId], references: [id])
  items    ProductSaleItem[]
  payment  Payment?

  @@map("product_sales")
}

model ProductSaleItem {
  saleId    BigInt  @map("sale_id")
  productId BigInt  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  sale    ProductSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@id([saleId, productId])
  @@map("product_sale_items")
}

model StockMovement {
  id              BigInt            @id @default(autoincrement())
  productId       BigInt            @map("product_id")
  movementType    StockMovementType @map("movement_type")
  quantity        Int
  contentQuantity Decimal?          @map("content_quantity") @db.Decimal(10, 2)
  contentUnit     ConsumableUnit?   @map("content_unit")
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model NotificationLog {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt?   @map("user_id")
  appointmentId    BigInt?   @map("appointment_id")
  channel          String    @db.VarChar(50)
  notificationType String    @map("notification_type") @db.VarChar(50)
  recipient        String    @db.VarChar(255)
  subject          String?   @db.VarChar(255)
  status           String    @db.VarChar(50)
  message          String?
  errorMessage     String?   @map("error_message")
  scheduledFor     DateTime? @map("scheduled_for")
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("notification_logs")
}

model ReportExportLog {
  id          BigInt   @id @default(autoincrement())
  adminUserId BigInt   @map("admin_user_id")
  reportType  String   @map("report_type") @db.VarChar(100)
  filters     String?
  fileName    String?  @map("file_name") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation("AdminReportExports", fields: [adminUserId], references: [id])

  @@map("report_export_logs")
}
